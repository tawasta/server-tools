<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_subscription_import_template_tree" model="ir.ui.view">
        <field name="name">subscription.import.template.tree</field>
        <field name="model">subscription.import.template</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
            </tree>
        </field>
    </record>

    <record id="view_subscription_import_template_form" model="ir.ui.view">
        <field name="name">subscription.import.template.form</field>
        <field name="model">subscription.import.template</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                    <group string="Field mappings">
                        <field name="line_ids">
                            <tree editable="bottom">
                                <field name="template_id"/>
                                <field name="model_group"/>
                                <field name="csv_column_name"/>
                                <field name="field_name"/>
                                <field name="is_search_field"/>
                                <field name="sequence" widget="handle" />
                            </tree>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_subscription_import_template" model="ir.actions.act_window">
        <field name="name">subscription Import Templates</field>
        <field name="res_model">subscription.import.template</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem
        id="subscription_import_template_menu"
        name="Subscription import templates"
        action="action_subscription_import_template"
        parent="subscription_oca.subscription_menu"
        sequence="4"
    />

</odoo>
