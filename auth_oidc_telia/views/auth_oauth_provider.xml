<?xml version="1.0" ?>
<odoo>
    <record model="ir.ui.view" id="view_oidc_provider_form">
        <field name="name">auth.oidc.provider.form</field>
        <field name="model">auth.oauth.provider</field>
        <field name="inherit_id" ref="auth_oauth.view_oauth_provider_form" />
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="audience" />
                <field name="token_audience" />
                <field name="token_endpoint" />
                <field name="token_map" />
                <field name="use_jwks" />
                <label name="jwks_local" for="jwks_local"/>
                <details colspan="1">
                    <summary>
                    </summary>
                        <field name="jwks_local" nolabel="1" />
                </details>
                <label name="jwks_public_local" for="jwks_public_local"/>
                <details colspan="1">
                    <summary>
                    </summary>
                        <field name="jwks_public_local" nolabel="1" />
                </details>
                <field name="jwks_uri" />
            </field>
        </field>
    </record>
</odoo>
