<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <template id="reset_password" inherit_id="auth_signup.reset_password">

        <!-- Reached via forgot password -link on login page -->
        <xpath expr="//button[@type='submit']" position="attributes">
            <attribute name="t-if">not token</attribute>
        </xpath>

        <!-- Reached via registration link in email -->
        <xpath expr="//button[@type='submit']" position="after">
            <button
                t-if="token"
                type="submit"
                class="btn btn-primary"
            >Set Password</button>
        </xpath>

    </template>
</odoo>
