<?xml version="1.0" ?>
<odoo>
    <record model="ir.ui.view" id="view_saml_token_tree">
        <field name="name">auth.saml.token.tree</field>
        <field name="model">auth_saml.token</field>
        <field name="arch" type="xml">
            <tree>
                <field name="create_date" />
                <field name="create_uid" />
                <field name="display_name" />
                <field name="id" />
                <field name="saml_access_token" />
                <field name="saml_name_id" />
                <field name="saml_provider_id" />
                <field name="user_id" />
                <field name="write_date" />
                <field name="write_uid" />
            </tree>
        </field>
    </record>
</odoo>
