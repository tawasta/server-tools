<?xml version="1.0" ?>
<odoo>
    <record model="ir.ui.view" id="view_saml_provider_form_tawasta">
        <field name="name">auth.saml.provider.form</field>
        <field name="model">auth.saml.provider</field>
        <field name="inherit_id" ref="auth_saml.view_saml_provider_form"></field>
        <field name="arch" type="xml">
            <xpath expr="//form/sheet/group/group[@name='odoo_settings']" position="inside">
                <label for="group_ids" />
                <div>
                    <field name="group_ids" />
                    <p class="help small">
                        Default groups for new users.
                    </p>
                </div>
                <field name="use_hashed_id" />
            </xpath>
            <xpath expr="//form/sheet/group[@name='idp_settings']" position="after">
                <group string="Contact person settings" name="contact_person_settings">
                    <label for="contact_person_ids" />
                    <div>
                        <field name="contact_person_ids">
                            <tree editable="bottom">
                                <field name="name" />
                                <field name="login" />
                            </tree>
                        </field>
                        <p class="help small">
                            Technical contact persons provided with Odoo SPs metadata.
                        </p>
                    </div>
                </group>
                <group string="Attribute settings" name="attribute_settings">
                    <label for="entity_attribute_ids" />
                    <div>
                        <field name="entity_attribute_ids" context="{'default_provider_id': id}" >
                            <tree editable="bottom">
                                <field name="name_format" />
                                <field name="name" />
                                <field name="friendly_name" />
                                <field name="value" />
                            </tree>
                        </field>
                        <p class="help small">
                            Entity attributes are returned in SP's (Odoo) metadata - this represents what attributes SP is requesting from the IdP.
                        </p>
                    </div>
                    <field name="required_attributes" />
                    <field name="optional_attributes" />
                </group>
            </xpath>
        </field>
    </record>
</odoo>
