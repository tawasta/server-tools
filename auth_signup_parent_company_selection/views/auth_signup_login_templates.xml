<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <!-- Add the parent partner selection to signup form -->
    <template id="fields" inherit_id="auth_signup.fields">

        <xpath expr="//div[hasclass('field-name')]" position="after">

            <div class="mb-3 parent-partner-container">
                <label for="parent_id">Member Organization</label>
                <select
                    name="parent_id"
                    id="parent_id"
                    t-att-value="parent_id"
                    class="form-control form-control-sm"
                >
                    <option value="">I'm not in a member organization</option>

                    <t t-foreach="allowed_parent_ids" t-as="allowed_parent_id">
                        <option t-att-value="allowed_parent_id.id">
                            <t t-out="allowed_parent_id.name" />
                        </option>
                    </t>
                </select>
                <t t-if="partner_id_help_text">
                    <span class="text-muted small">
                        <t t-out="partner_id_help_text" />
                    </span>
                </t>

            </div>
        </xpath>
    </template>
</odoo>
