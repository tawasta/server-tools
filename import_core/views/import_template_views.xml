<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_generic_import_template_tree" model="ir.ui.view">
        <field name="name">generic.import.template.tree</field>
        <field name="model">generic.import.template</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
            </tree>
        </field>
    </record>

    <record id="view_generic_import_template_form" model="ir.ui.view">
        <field name="name">generic.import.template.form</field>
        <field name="model">generic.import.template</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="allowed_model_ids" invisible="1"/>
                    </group>

                    <group string="Import steps">
                        <field name="step_ids" widget="many2many_tags" options="{'no_create': True}"/>
                        <p class="text-muted">
                            Steps are provided by installed step modules.
                            Steps run in order by their sequence.
                        </p>
                    </group>

                    <group string="Field mappings">
                        <field name="line_ids">
                            <tree editable="bottom">
                                <field name="sequence" widget="handle"/>
                                <field name="csv_column_name"/>
                                <field name="model_id"
                                       options="{'no_create': True}"
                                       domain="[('transient','=',False), ('id','in', parent.allowed_model_ids)]"/>

                                <field name="field_id" options="{'no_create': True}"/>
                                <field name="is_search_field"/>
                            </tree>
                        </field>
                    </group>

                </sheet>
            </form>
        </field>
    </record>

</odoo>