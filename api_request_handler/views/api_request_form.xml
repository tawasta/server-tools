<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_api_request_form" model="ir.ui.view">
        <field name="name">api.request.form</field>
        <field name="model">api.request</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button 
                        class="oe_stat_button" 
                        type="object" 
                        name="action_open_related_record"
                        string="Related Record" 
                        icon="fa-external-link">Related Record</button>                    
                    </div>

                    <group>
                        <field name="name" readonly="1"/>
                        <field name="method" readonly="1"/>
                        <field name="endpoint" readonly="1"/>
                        <field name="headers" readonly="1"/>
                        <field name="params" readonly="1"/>
                        <field name="values" readonly="1"/>
                        <field name="payload" readonly="1"/>
                        <field name="status_code" readonly="1"/>
                        <field name="successful" readonly="1"/>
                        <field name="res_model" readonly="1"/>
                        <field name="res_id" readonly="1"/>
                    </group>
                    <group>
                        <field name="create_date" readonly="1"/>
                    </group>
                    <notebook>
                        <page string="Request" invisible="not payload">
                            <field name="payload" readonly="1"/>
                        </page>
                        <page string="Response">
                            <field name="response" readonly="1"/>
                        </page>
                        <page string="Error" invisible="not error_message">
                            <field name="error_message" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
